# Copy to .env.local and fill in. See README.md for where each value comes from.

# Sanity: "development" locally, "production" on the live site only.
NEXT_PUBLIC_SANITY_PROJECT_ID="l6u3st01"
NEXT_PUBLIC_SANITY_DATASET="development"
# Editor token (sanity.io/manage -> API -> Tokens). Server only: saves orders, reduces stock.
SANITY_API_WRITE_TOKEN=""
# Shared with the Sanity publish webhook (/api/revalidate).
SANITY_REVALIDATE_SECRET=""

# Razorpay (test keys locally) - https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
# Shared with the Razorpay webhook (/api/razorpay/webhook).
RAZORPAY_WEBHOOK_SECRET=""

# Resend (order, shipping and delivery emails) - https://resend.com/api-keys
# Until your domain is verified in Resend, EMAIL_FROM must stay onboarding@resend.dev
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Shiprocket (all courier partners). Leave blank to ship by hand.
# An API user (Shiprocket -> Settings -> API), and the pickup address's nickname and
# pincode from Settings -> Pickup Addresses.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""
SHIPROCKET_PICKUP_PINCODE=""
# Security token set on the Shiprocket tracking webhook (/api/delivery/updates).
SHIPROCKET_WEBHOOK_TOKEN=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Fallbacks only: the Studio's Storefront Settings take priority.
NEXT_PUBLIC_STORE_NAME="Shravs Saree Collection"
NEXT_PUBLIC_WHATSAPP_NUMBER="919121238445"

# Only for `npm run migrate:sanity` (one-off copy from the old Postgres database).
DATABASE_URL=""
DIRECT_URL=""
