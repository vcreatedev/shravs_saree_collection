# Postgres connection strings (Supabase). DATABASE_URL is the pooled/serverless-safe
# connection the app uses at runtime; DIRECT_URL is the direct connection used only
# for `prisma db push` / `prisma migrate` (schema changes need a non-pooled connection).
# Get both from Supabase: Project Settings -> Database -> Connect -> Direct connection /
# Transaction pooler. (Using a different Postgres host? DIRECT_URL can equal DATABASE_URL.)
DATABASE_URL="postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require"

# Razorpay (test mode keys - replace with your own from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"

# Admin auth
ADMIN_EMAIL="admin@store.com"
ADMIN_PASSWORD="Admin@123"
AUTH_SECRET="dev-only-change-this-secret-in-production-please-1234567890"

# WhatsApp business number (with country code, no + or spaces), e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
NEXT_PUBLIC_STORE_NAME="Shravs Saree Collection"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Resend (email invoice delivery) - get a free API key at https://resend.com/api-keys
# Until you verify your own domain in Resend, EMAIL_FROM must stay onboarding@resend.dev
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# Cloudinary (product image hosting) - Cloud Name, API Key, API Secret from your
# Cloudinary dashboard home page. Only used by scripts/upload-assets.ts (the one-time
# upload script), not by the running app - images are referenced by their Cloudinary URL.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Shiprocket (order shipping) - email/password of a Shiprocket account with API access,
# and the pickup location nickname configured under Settings -> Pickup Addresses in the
# Shiprocket dashboard. Leave blank to disable the "Create Shipment" admin action.
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION=""
